# ===== Obrigatório em produção (docker compose) =====
# Domínio público (o DNS precisa apontar para este servidor). Ex.: treino.seudominio.com.br
DOMAIN=treino.example.com

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Use só letras e números (vai dentro de uma URL). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha

# ===== Opcional =====
# POSTGRES_DB=muscle_track
# POSTGRES_USER=muscle_track

# Em produção deixe False. No seu computador (sem Docker), use True.
DEBUG=False

# Alunos entram por link de convite enviado pela personal; deixe False.
ALLOW_PUBLIC_SIGNUP=False

# Política de privacidade (LGPD): quem é o responsável pelos dados e como falar com ele
# PRIVACY_CONTROLLER_NAME=Maria Silva - Personal Trainer
# PRIVACY_CONTACT_EMAIL=maria@seu-dominio.com

# Local das aulas que aparece no Google Agenda / Apple Calendar (opcional)
# CALENDAR_LOCATION=Rua Exemplo, 123 - Academia Tal

# Antecedência mínima (em horas) para a aluna pedir remarcação/cancelamento pelo app (padrão 24)
# AGENDA_NOTICE_HOURS=24
# Feriados nacionais que o preenchimento da agenda pula: PT (padrão), BR ou vazio para nenhum
# HOLIDAYS_REGION=PT

# Chave Pix que aparece na mensagem de cobrança pelo WhatsApp (opcional)
# PIX_KEY=seu-pix@exemplo.com

# Geração de treino com IA (opcional)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# E-mail (avisos e "esqueci minha senha"). Com usuário e senha o envio por SMTP liga sozinho; sem isso os
# e-mails vão para o log. No Gmail use uma "senha de app" (Conta Google > Segurança > Senhas de app).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=senha-de-app
# DEFAULT_FROM_EMAIL=noreply@seu-dominio.com

# DNS que o container do app usa para sair para a internet (padrão: Cloudflare e Google). Troque se a sua
# rede exigir o DNS interno. Sem isso, um filtro de DNS (Pi-hole etc.) pode bloquear o aviso no aparelho.
# WEB_DNS_1=1.1.1.1
# WEB_DNS_2=8.8.8.8

# Lembretes automáticos (0 desliga): horas antes da aula e dias antes do plano vencer
# REMINDER_CLASS_HOURS=24
# REMINDER_PLAN_DAYS=3
# REMINDER_CLASS_SOON_HOURS=2        # segundo lembrete curto, algumas horas antes da aula
# REMINDER_REASSESSMENT_DAYS=45      # dias sem avaliação até lembrar o aluno de uma nova
# REMINDER_INACTIVE_DAYS=7           # dias sem treinar até um aviso gentil ao aluno
# REMINDER_DIGEST_HOUR=7             # hora do resumo da personal (-1 desliga)
# REMINDER_NUDGE_HOUR=10             # hora dos avisos aos alunos (reavaliação, sem treinar)

# Aviso no aparelho (web push): docker compose exec web python manage.py generate_vapid_keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Avisos no Telegram (opcional): crie o bot com @BotFather, ponha aqui o token e o @usuário do bot, invente um
# segredo (só letras, números, _ e -, até 256) e depois rode: docker compose exec web python manage.py telegram_set_webhook
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# Avançado (os padrões já servem): WEB_CONCURRENCY=3, LOG_LEVEL=INFO, SECURE_HSTS_SECONDS=86400
# Desenvolvimento local sem Docker: deixe DOMAIN vazio e defina DEBUG=True; usa SQLite.

# ===== Identidade e login social (opcionais) =====
# Nome mostrado no topo, na landing e no app instalado (vazio = Muscle Track)
# STUDIO_NAME=Studio da Ana
# Cada botão só aparece quando as duas chaves existem (ver README: "Entrar com Google, Facebook e X")
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# Backups automáticos (serviço "backup"): todo dia depois das BACKUP_HOUR (horário do TZ), banco + fotos/mídia,
# guardados em ./backups. Mantém os últimos 7 dias e os últimos 4 domingos.
# BACKUP_DIR=./backups
# BACKUP_HOUR=3
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# TZ=America/Sao_Paulo
# Cópia FORA do servidor (recomendado: se o servidor for perdido, os backups nele também são). Qualquer destino do
# rclone (S3, Backblaze B2, Google Drive...). Exemplo para Backblaze B2 / S3:
# BACKUP_RCLONE_REMOTE=offsite:nome-do-bucket/muscle-track
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=...
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=...
# Aviso na tela inicial da personal quando o último backup bom é mais antigo que isso (horas)
# BACKUP_MAX_AGE_HOURS=36
