# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,http://localhost:8000

# Database (SQLite is default for development)
# For Render production, add DATABASE_URL (automatically provided by Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Python Version (for Render deployment)
PYTHON_VERSION=3.11.0

# Email Settings (for account activation)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@muscle-track.com

# Account Email Verification
# Options: 'none' (desabilitada), 'optional' (recomendado), 'mandatory' (obrigatória)
ACCOUNT_EMAIL_VERIFICATION=optional

# Social Auth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Social Auth - Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Social Auth - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OpenAI API (for AI-powered workout generation)
OPENAI_API_KEY=your-openai-api-key

# Site URL (for production)
SITE_URL=https://your-app.onrender.com

# Avatar Upload Settings
AVATAR_MAX_SIZE_MB=5
AVATAR_MAX_WIDTH=2000
AVATAR_MAX_HEIGHT=2000
AVATAR_MIN_WIDTH=100
AVATAR_MIN_HEIGHT=100
