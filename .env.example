# ===== Obrigatório em produção (docker compose) =====
# Domínio público (o DNS precisa apontar para este servidor). Ex.: treino.seudominio.com.br
DOMAIN=treino.example.com

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Use só letras e números (vai dentro de uma URL). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha

# ===== Opcional =====
# POSTGRES_DB=muscle_track
# POSTGRES_USER=muscle_track

# Em produção deixe False. No seu computador (sem Docker), use True.
DEBUG=False

# Alunos entram por link de convite enviado pela personal; deixe False.
ALLOW_PUBLIC_SIGNUP=False

# Política de privacidade (LGPD): quem é o responsável pelos dados e como falar com ele
# PRIVACY_CONTROLLER_NAME=Maria Silva - Personal Trainer
# PRIVACY_CONTACT_EMAIL=maria@seu-dominio.com

# Geração de treino com IA (opcional)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# E-mail (opcional; só necessário para o "esqueci minha senha"). Sem isso os e-mails vão para o log
# e a aluna deve pedir um novo link de acesso à personal (ficha do aluno > Redefinir senha).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=senha-de-app
# DEFAULT_FROM_EMAIL=noreply@seu-dominio.com

# Avançado (os padrões já servem): WEB_CONCURRENCY=3, LOG_LEVEL=INFO, SECURE_HSTS_SECONDS=86400
# Desenvolvimento local sem Docker: deixe DOMAIN vazio e defina DEBUG=True; usa SQLite.
