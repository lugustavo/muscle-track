msgid "Não foi possível concluir. Tente de novo."
msgstr "Couldn't finish. Try again."

msgid "Sem conexão. Tente de novo."
msgstr "No connection. Try again."

msgid "Aula de %(person)s movida para %(when)s."
msgstr "%(person)s's class moved to %(when)s."

msgid "Atenção: se sobrepõe a outra aula (%(classes)s)."
msgstr "Warning: this overlaps another class (%(classes)s)."

msgid "Movimento desfeito."
msgstr "Move undone."

msgid "Peso (kg)"
msgstr "Weight (kg)"

#, no-javascript-format
msgid "% gordura"
msgstr "% body fat"

msgid "Cintura (cm)"
msgstr "Waist (cm)"

msgid ""
"A câmera guiada só funciona em página segura (https). Escolha as fotos da "
"galeria."
msgstr ""
"The guided camera only works on a secure page (https). Pick the photos from "
"the gallery."

msgid ""
"Não foi possível usar a câmera (permissão negada ou câmera ocupada). Escolha"
" as fotos da galeria."
msgstr ""
"Could not use the camera (permission denied or camera busy). Pick the photos"
" from the gallery."

msgid "Pronto! Veja a prévia e salve o exercício para guardar a animação."
msgstr "Done! Check the preview and save the exercise to keep the animation."

msgid "Não foi possível trocar de câmera."
msgstr "Could not switch cameras."

msgid "Há um rascunho deste formulário salvo às %(time)s."
msgstr "There's a draft of this form saved at %(time)s."

msgid "Restaurar"
msgstr "Restore"

msgid "Descartar"
msgstr "Discard"

msgid "Entendi"
msgstr "Got it"

msgid "Próximo"
msgstr "Next"

msgid "Foto"
msgstr "Photo"

msgid "Fechar"
msgstr "Close"

msgid "Foto anterior"
msgstr "Previous photo"

#| msgid "Próximo"
msgid "Próxima foto"
msgstr "Next photo"

msgid ""
"Não foi possível usar a câmera com guias. Abrindo a câmera do aparelho."
msgstr "Could not use the camera with guides. Opening the device camera."

msgid ""
"Não foi possível usar a câmera (permissão negada ou câmera ocupada). Escolha"
" a foto da galeria."
msgstr ""
"Couldn't use the camera (permission denied or camera in use). Choose a photo"
" from your gallery."

msgid "Tire ou escolha uma foto antes de salvar."
msgstr "Take or choose a photo before saving."

msgid ""
"Nenhuma câmera encontrada neste aparelho: escolha a foto da galeria ou dos "
"arquivos."
msgstr ""
"No camera found on this device: choose a photo from your gallery or files."

msgid ""
"Este navegador não aceita avisos no aparelho. No iPhone, adicione o app à "
"tela de início primeiro."
msgstr ""
"This browser doesn't support device notifications. On iPhone, add the app to"
" your home screen first."

msgid "Ativando…"
msgstr "Activating…"

msgid ""
"Permissão negada. Libere as notificações nas configurações do navegador."
msgstr "Permission denied. Allow notifications in your browser settings."

msgid "Não foi possível ativar."
msgstr "Couldn't activate."

msgid "Pronto! Este aparelho vai receber os avisos."
msgstr "Done! This device will receive notifications."

msgid ""
"Sem conexão. Pode continuar treinando: as séries ficam salvas no aparelho e "
"são enviadas quando a internet voltar."
msgstr ""
"No connection. You can keep working out: your sets are saved on the device "
"and sent when the internet comes back."

#, javascript-format
msgid ""
"Sem conexão. Você está vendo a cópia salva em %s; pode estar desatualizada."
msgstr ""
"No connection. You are seeing the copy saved on %s; it may be out of date."

#, javascript-format
msgid "ver todos (%s)"
msgstr "see all (%s)"

msgid "Nada encontrado para \"%(query)s\"."
msgstr "Nothing found for \"%(query)s\"."

#, javascript-format
msgid "%s resultado"
msgid_plural "%s resultados"
msgstr[0] "%s result"
msgstr[1] "%s results"

msgid "Nada encontrado"
msgstr "Nothing found"

#, javascript-format
msgid "Preencher agenda (%s aula)"
msgid_plural "Preencher agenda (%s aulas)"
msgstr[0] "Fill schedule (%s class)"
msgstr[1] "Fill schedule (%s classes)"

#, javascript-format
msgid "Tema: %s"
msgstr "Theme: %s"

msgid "Retomar"
msgstr "Resume"

msgid "Pausar"
msgstr "Pause"

msgid "Guardado neste aparelho"
msgstr "Saved on this device"

msgid "Salvo"
msgstr "Saved"

#, javascript-format
msgid "Offline · %s pendente(s)"
msgstr "Offline · %s pending"

msgid "Salvando…"
msgstr "Saving…"

msgid ""
"Um valor não foi aceito pelo servidor. Vou recarregar a página para "
"sincronizar."
msgstr "The server didn't accept a value. I'll reload the page to sync."

msgid ""
"Esta sessão de treino já foi encerrada ou expirou. Vou recarregar a página."
msgstr ""
"This workout session has already ended or expired. I'll reload the page."

msgid "Todos os exercícios concluídos"
msgstr "All exercises completed"

msgid "Exercício <strong id=\"progressCurrent\">%(current)s</strong> de %(total)s"
msgstr "Exercise <strong id=\"progressCurrent\">%(current)s</strong> of %(total)s"

msgid "Concluídos"
msgstr "Completed"

msgid "Próximo: %(name)s"
msgstr "Next: %(name)s"

msgid "Todos os exercícios concluídos!"
msgstr "All exercises completed!"

msgid "Todas as séries feitas. Bom trabalho!"
msgstr "All sets done. Great job!"

#, javascript-format
msgid "Faltam %s série(s)."
msgstr "%s set(s) remaining."

msgid "🏆 Novo recorde de carga!"
msgstr "🏆 New load record!"

msgid "Enviando..."
msgstr "Sending..."

msgid ""
"Sua sessão expirou. Entre de novo no app para enviar; o treino continua "
"guardado neste aparelho."
msgstr ""
"Your session expired. Sign in to the app again to send it; the workout is "
"still saved on this device."

msgid ""
"Não consegui falar com o servidor. O treino continua guardado; tente de novo"
" em instantes."
msgstr ""
"Could not reach the server. The workout is still saved; try again in a "
"moment."

#, javascript-format
msgid ""
"O servidor teve um problema (erro %s). O treino continua guardado; tente de "
"novo em instantes."
msgstr ""
"The server had a problem (error %s). The workout is still saved; try again "
"in a moment."

#, javascript-format
msgid ""
"O servidor não aceitou este treino (erro %s). Ele continua guardado neste "
"aparelho; avise sua personal."
msgstr ""
"The server did not accept this workout (error %s). It is still saved on this"
" device; tell your trainer."

#, javascript-format
msgid "Faltam %s série(s). Finalizar mesmo assim?"
msgstr "%s set(s) remaining. Finish anyway?"

msgid "Descartar este treino? Nada do que foi feito nele será guardado."
msgstr "Discard this workout? Nothing done in it will be kept."

msgid "Treino enviado!"
msgstr "Workout sent!"

msgid "Ver resumo"
msgstr "View summary"
